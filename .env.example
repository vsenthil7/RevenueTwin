# RevenueTwin deployment configuration. Copy to .env and fill in real values.
# .env is git-ignored; NEVER commit real secrets.

# --- Postgres (required) ---
POSTGRES_USER=revenuetwin
# Use a strong, randomly generated password (e.g. openssl rand -base64 24).
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
POSTGRES_DB=revenuetwin

# --- API ---
# Host port to expose the API/web console on (container always listens on 8787).
API_PORT=8787

# --- Real authentication (OIDC/Entra) ---
# Set all three to enable real bearer-token auth (S65). If left blank, the app uses the
# x-user-id demo shim, which is NOT safe for production data.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
