{
  "name": "revenuetwin",
  "version": "0.1.0",
  "description": "Enterprise Revenue Digital Twin & Revenue Assurance Operating System",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist --declaration",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/functional/*.test.ts tests/negative/*.test.ts",
    "test:coverage": "c8 --all --include \"src/**/*.ts\" --exclude \"src/app/demo-live.ts\" --exclude \"src/edge/pg-factory.ts\" --reporter=text --reporter=json-summary --check-coverage --branches 100 --lines 100 --functions 100 --statements 100 node --import tsx --test tests/unit/*.test.ts tests/functional/*.test.ts tests/negative/*.test.ts",
    "test:frontend": "node --import tsx --test tests/e2e/*.jsdom.test.ts",
    "test:e2e": "playwright test",
    "demo-offline": "node --import tsx scripts/demo-offline.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "status": "node --import tsx scripts/status.ts",
    "demo:live": "node --import tsx src/app/demo-live.ts",
    "serve:web": "node --import tsx scripts/serve-web.ts",
    "start": "node --import tsx scripts/serve-web.ts",
    "mutation": "stryker run"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^9.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.11.0",
    "c8": "^11.0.0",
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
